# ==============================================================================
# YOLO Face Detection - Environment Configuration Template
# Renomeie este arquivo para .env e ajuste os valores conforme seu ambiente
# ==============================================================================

# Caminho dos pesos do modelo (padrão: models/best.pt)
MODEL_PATH=models/best.pt

# Limiar de Confiança para Detecção Facial (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.25

# Índice da Câmera / Webcam (0 = câmera principal integrada ou USB padrão)
WEBCAM_INDEX=0

# Resolução de Inferência (512 recomendado para maior sensibilidade)
IMG_SIZE=512

# Dispositivo de Processamento (0 para GPU CUDA ou 'cpu')
DEVICE=0
